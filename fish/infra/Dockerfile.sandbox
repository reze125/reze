# REZE Sandbox Docker Image
# 자기 코드 진화 테스트용 격리 환경

FROM python:3.11-slim

# 시스템 패키지
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    && rm -rf /var/lib/apt/lists/*

# 작업 디렉토리
WORKDIR /app

# Python 패키지 (REZE 의존성)
RUN pip install --no-cache-dir \
    pytest \
    pytest-timeout \
    pytest-asyncio \
    aiohttp \
    httpx \
    pydantic \
    python-dateutil

# 보안: root가 아닌 사용자로 실행
RUN useradd -m -u 1000 sandbox
USER sandbox

# 기본 명령
CMD ["python3", "-c", "print('REZE Sandbox Ready')"]
